    {
      "id": "hasFilesToAttach",
      "type": "core.logic.decision",
      "typeVersion": "1.4",
      "display": {
        "label": "hasFilesToAttach",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "Files to attach",
        "falseLabel": "False",
        "expression": "($vars.downloadedFiles || []).length > 0"
      },
      "uniqueId": "528d5c9b-9800-4995-bf88-d146284a7732"
    },
    {
