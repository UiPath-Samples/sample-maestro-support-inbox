    {
      "id": "collectAttachment",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "collectAttachment",
        "icon": "code"
      },
      "inputs": {
        "script": "\n  const files = $vars.downloadedFiles || [];\n  return { files: files.concat([$vars.downloadAttachment1.output]) };\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "files": {
              "type": "array"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "parentId": "eachAttachment",
      "uniqueId": "9278e7a5-58a5-4ea9-8955-e1c96e4b4fef"
    },
    {
      "id": "prepareFiles",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "prepareFiles",
        "icon": "code"
      },
      "inputs": {
        "script": "\n  const files = $vars.downloadedFiles || [];\n  const readable = [];\n  const other = [];\n  for (const f of files) {\n    const mime = String((f && f.MimeType) || \"\").toLowerCase();\n    const name = String((f && f.FullName) || \"\").toLowerCase();\n    const isPdf = mime === \"application/pdf\" || /\\.pdf$/.test(name);\n    const isImage = mime.indexOf(\"image/\") === 0 || /\\.(png|jpe?g|gif|webp|bmp|tiff?|heic)$/.test(name);\n    if (isPdf || isImage) readable.push(f);\n    else other.push(f);\n  }\n  const attachmentList = readable.length === 0 ? \"(none)\" : JSON.stringify(readable.map((f) => ({ ID: f.ID, FullName: f.FullName, MimeType: f.MimeType })), null, 2);\n  const otherAttachments = other.length === 0 ? \"(none)\" : other.map((f) => f.FullName).join(\", \");\n  return { attachments: readable, attachmentList: attachmentList, otherAttachments: otherAttachments };\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "attachments": {
              "type": "array"
            },
            "attachmentList": {
              "type": "string"
            },
            "otherAttachments": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "cf27ed48-0367-42a9-afd2-a2d6cce2302f"
    },
    {
      "id": "classify",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "classify",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "You triage emails sent to a software company's customer support inbox.\nUse the sender, subject and body you are given, and the email's PDF and image attachments when it has any.\n\nAttachments: the user message lists each PDF or image attachment with its ID, FullName and MimeType. When that list is not \"(none)\", call the Analyze Files tool on those attachments, passing each attachment's ID exactly as it is listed, and read them to extract the customer's account ID, the amount (with its currency) and any error code. Never make up an attachment ID, and do not call the tool when the list is \"(none)\". Other attachments are listed by name only and are not read.\nUse what you extract, together with the email itself, to decide the category and to write the reply. For example, an invoice or receipt that shows a charge points to billing, and a screenshot that shows an error code points to bug.\n\nReturn a result conforming to the output schema:\n- category: exactly one of billing | bug | how-to | other | spam.\n  billing = charges, invoices, refunds, plans, payment. bug = the product is broken or behaves wrongly.\n  how-to = the customer asks how to do something with the product. spam = unsolicited marketing, phishing, scams or mail not meant for support.\n  other = a genuine customer email that fits none of the above.\n- summary: one or two sentences for the support team describing what the customer wants. Include the account ID, amount and error code you found, when there are any.\n- replyText: a short, polite reply to the customer, signed 'Support team'. Acknowledge the request and say what happens next. When you found an account ID, amount or error code, refer to it so the customer knows it was read. Do not promise refunds, credits or fixes. For spam, return an empty string.\n- refundRequested: true only if the customer explicitly asks for a refund or money back; otherwise false.\n- accountId: the customer's account ID from the email or its attachments, or an empty string if there is none.\n- amount: the amount from the email or its attachments, with its currency, or an empty string if there is none.\n- errorCode: the error code from the email or its attachments, or an empty string if there is none.",
        "userPrompt": "From: {{ $vars.getEmail.output.From.Name }} <{{ $vars.getEmail.output.From.Email }}>\nSubject: {{ $vars.getEmail.output.Subject }}\n\n{{ $vars.getEmail.output.Body }}\n\nPDF and image attachments to read with the Analyze Files tool (ID, FullName, MimeType):\n{{ $vars.prepareFiles.output.attachmentList }}\n\nAttachment files: {{ $vars.prepareFiles.output.attachments }}\n\nOther attachments (not read): {{ $vars.prepareFiles.output.otherAttachments }}",
        "model": "claude-sonnet-5-5",
        "mode": "standard",
        "temperature": 1,
        "maxTokenPerResponse": 16384,
        "maxIterations": 25,
        "isConversational": false,
        "guardrails": [],
        "name": "classify",
        "agentInputVariables": [
          {
            "id": "getEmail__output__From__Name",
            "type": "string",
            "binding": "=js:$vars.getEmail.output.From.Name"
          },
          {
            "id": "getEmail__output__From__Email",
            "type": "string",
            "binding": "=js:$vars.getEmail.output.From.Email"
          },
          {
            "id": "getEmail__output__Subject",
            "type": "string",
            "binding": "=js:$vars.getEmail.output.Subject"
          },
          {
            "id": "getEmail__output__Body",
            "type": "string",
            "binding": "=js:$vars.getEmail.output.Body"
          },
          {
            "id": "prepareFiles__output__attachmentList",
            "type": "string",
            "binding": "=js:$vars.prepareFiles.output.attachmentList"
          },
          {
            "id": "prepareFiles__output__attachments",
            "type": "array",
            "binding": "=js:$vars.prepareFiles.output.attachments"
          },
          {
            "id": "prepareFiles__output__otherAttachments",
            "type": "string",
            "binding": "=js:$vars.prepareFiles.output.otherAttachments"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "category",
            "type": "string"
          },
          {
            "id": "summary",
            "type": "string"
          },
          {
            "id": "replyText",
            "type": "string"
          },
          {
            "id": "refundRequested",
            "type": "boolean"
          },
          {
            "id": "accountId",
            "type": "string"
          },
          {
            "id": "amount",
            "type": "string"
          },
          {
            "id": "errorCode",
            "type": "string"
          }
        ],
        "source": "0174c276-fdb5-4b4e-bbb6-599f9aa148f8",
        "modelSkipsTemperature": true
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
