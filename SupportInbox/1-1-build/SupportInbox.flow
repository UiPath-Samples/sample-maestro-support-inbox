        "control-flow",
        "switch",
        "case",
        "when"
      ],
      "sortOrder": 62,
      "display": {
        "label": "Switch",
        "icon": "between-horizontal-start"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ],
          "visible": true
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "case-{item.id}",
              "type": "source",
              "handleType": "output",
              "label": "{item.label || 'Case ' + (index + 1)}",
              "repeat": "inputs.cases"
            },
            {
              "id": "default",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.defaultBranch.label}",
              "visible": "{inputs.cases.length === 0 || inputs.defaultBranch.enabled !== false}"
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ExclusiveGateway"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "cases": {
            "type": "array",
            "minItems": 1,
            "errorMessage": "At least one case is required",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "errorMessage": "Add a condition"
                }
              },
              "required": [
                "expression"
              ]
            }
          },
          "defaultBranch": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "matchAllCases": {
            "type": "boolean"
          }
        },
        "required": [
          "cases"
        ]
      },
      "outputDefinition": {},
      "inputDefaults": {
        "cases": [
          {
            "id": "default-1",
            "label": "Case 1",
            "expression": ""
          },
          {
            "id": "default-2",
            "label": "Case 2",
            "expression": ""
          }
        ],
        "defaultBranch": {
          "enabled": true,
          "label": "Default"
        },
        "matchAllCases": false
      },
      "form": {
        "id": "switch-properties",
        "title": "Switch configuration",
        "sections": [
          {
            "id": "cases",
            "title": "Cases",
            "description": "Cases are evaluated in order.",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.cases",
                "type": "custom",
                "label": "Switch cases",
                "component": "case-list-editor",
                "componentProps": {
                  "defaultBranchRow": true,
                  "minCases": 1,
                  "maxCases": 10,
                  "expressionPlaceholder": "$vars.httpRequest1.output.statusCode >= 200 && $vars.httpRequest1.output.statusCode < 300",
                  "expressionValidationFields": [
                    {
                      "subPath": "expression",
                      "validationMode": "expression",
                      "expectedType": "boolean"
                    }
                  ]
                }
              },
              {
                "name": "inputs.matchAllCases",
                "type": "switch",
                "label": "Match all cases",
                "description": "The flow continues down every case whose condition is true, not only the first.",
                "defaultValue": false
              }
            ]
          }
        ]
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    },
