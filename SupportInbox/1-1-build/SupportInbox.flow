    {
      "id": "getEmail",
      "type": "uipath.connector.uipath-google-gmail.get-email-by-id",
      "typeVersion": "1.0.0",
      "display": {
        "label": "getEmail",
        "icon": "https://cloud.uipath.com/7a3723d6-b0bd-4036-8c3f-323af55a2003/studio_/typecache/icons/70091673b4573a26ec5090fa697c3bf61a0bedf4c77a302986b69d53bea30191.svg"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-google-gmail",
          "method": "GET",
          "endpoint": "/hubs/general/NormalizedMessage/{id}",
          "objectName": "NormalizedMessage",
          "inputMetadata": {},
          "errorState": {
            "hasError": false
          },
          "telemetryData": {
            "connectorKey": "uipath-google-gmail",
            "connectorName": ""
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"customFieldsRequestDetails\":null,\"executionType\":null,\"operation\":\"retrieve\",\"packageVersion\":\"1.0.0\",\"connectorVersion\":null,\"unifiedTypesCompatible\":true,\"savedFilterTrees\":null,\"objectName\":\"NormalizedMessage\",\"httpMethod\":\"GET\",\"instanceParameters\":{\"connectorKey\":\"uipath-google-gmail\",\"objectName\":\"NormalizedMessage\",\"httpMethod\":\"GETBYID\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"method\"},\"path\":\"/hubs/general/NormalizedMessage/{id}\"}}",
          "uiPathActivityTypeId": "9d941cc8-bff4-3ed4-aff4-7d7617e2c4e0",
          "connectionId": "593b14fc-f445-4c6a-89b7-016833566cab",
          "connectionResourceId": "593b14fc-f445-4c6a-89b7-016833566cab",
          "connectionFolderKey": "e52f05df-eac6-4f5e-b25d-ebd56830d665",
          "bodyParameters": {},
          "pathParameters": {
            "id": "=js:$vars.start?.output?.messageId || $vars[\"emailReceivedInbox1\"]?.output?.ID"
          }
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the connector.",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "7dc252b7-ecd2-490b-9cc1-b1e42c21843f"
    },
    {
      "id": "classify",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "classify",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "You triage emails sent to a software company's customer support inbox.\nUse only the sender, subject and body you are given.\nReturn a result conforming to the output schema:\n- category: exactly one of billing | bug | how-to | other | spam.\n  billing = charges, invoices, refunds, plans, payment. bug = the product is broken or behaves wrongly.\n  how-to = the customer asks how to do something with the product. spam = unsolicited marketing, phishing, scams or mail not meant for support.\n  other = a genuine customer email that fits none of the above.\n- summary: one or two sentences for the support team describing what the customer wants.\n- replyText: a short, polite reply to the customer, signed 'Support team'. Acknowledge the request and say what happens next. Do not promise refunds, credits or fixes. For spam, return an empty string.\n- refundRequested: true only if the customer explicitly asks for a refund or money back; otherwise false.",
        "userPrompt": "From: {{ $vars.getEmail.output.From.Name }} <{{ $vars.getEmail.output.From.Email }}>\nSubject: {{ $vars.getEmail.output.Subject }}\n\n{{ $vars.getEmail.output.Body }}",
        "model": "claude-sonnet-5-5",
        "mode": "standard",
        "temperature": 1,
        "maxTokenPerResponse": 16384,
        "maxIterations": 25,
        "isConversational": false,
        "guardrails": [],
        "name": "classify",
        "agentInputVariables": [
          {
            "id": "getEmail__output__From__Name",
            "type": "string",
            "binding": "=js:$vars.getEmail.output.From.Name"
          },
          {
            "id": "getEmail__output__From__Email",
            "type": "string",
            "binding": "=js:$vars.getEmail.output.From.Email"
          },
          {
            "id": "getEmail__output__Subject",
            "type": "string",
            "binding": "=js:$vars.getEmail.output.Subject"
          },
          {
            "id": "getEmail__output__Body",
            "type": "string",
            "binding": "=js:$vars.getEmail.output.Body"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "category",
            "type": "string"
          },
          {
            "id": "summary",
            "type": "string"
          },
          {
            "id": "replyText",
            "type": "string"
          },
          {
            "id": "refundRequested",
            "type": "boolean"
          }
        ],
        "source": "c71c0687-5eb8-410b-8906-3ff61dc89368",
        "modelSkipsTemperature": true
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "d9c5a17d-e7ca-423e-8b9a-54c8cb9404c0"
    },
    {
      "id": "byCategory",
      "type": "core.logic.switch",
      "typeVersion": "1.4",
      "display": {
        "label": "byCategory",
        "icon": "between-horizontal-start"
      },
      "inputs": {
        "cases": [
          {
            "id": "case_1",
            "label": "Billing",
            "expression": "$vars.classify.output.category === \"billing\""
          },
          {
            "id": "case_2",
            "label": "Bug",
            "expression": "$vars.classify.output.category === \"bug\""
          },
          {
            "id": "case_3",
            "label": "How-to",
            "expression": "$vars.classify.output.category === \"how-to\""
          },
          {
            "id": "case_4",
            "label": "Spam",
            "expression": "$vars.classify.output.category === \"spam\""
          }
        ],
        "defaultBranch": {
          "enabled": true,
          "label": "Default"
        }
      },
      "uniqueId": "520abf18-ed0f-4e3f-b8a8-59f986cbd30e"
    },
    {
      "id": "ticketBilling",
