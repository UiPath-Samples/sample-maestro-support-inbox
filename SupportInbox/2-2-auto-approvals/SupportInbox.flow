    {
      "id": "declineRefund",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Decline refund",
        "icon": "code"
      },
      "inputs": {
        "script": "\n  return { route: \"decline\", reason: String($vars.checkRefund.output.reason || \"\") };\n"
