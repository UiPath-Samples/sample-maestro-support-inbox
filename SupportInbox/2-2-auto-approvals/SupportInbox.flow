          },
          "objectName": "curated_create_issue",
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"responseAsFile\":false,\"connectorVersion\":\"1.14.0\",\"scriptRef\":null,\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"fields_sub_issuetype_sub_id\",\"10009\"],[\"fields_sub_project_sub_key\",\"SUP\"]]},\"instanceParameters\":{\"connectorKey\":\"uipath-atlassian-jira\",\"objectName\":\"curated_create_issue\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"curated_create_issue\",\"operation\":\"create\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/curated_create_issue\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_curated_create_issue\"},\"optionalConfiguration\":{\"_textBlocks\":[{\"name\":\"defaultMessage\",\"text\":\"Select the Project and then the Issue type to load the input fields dynamically. After that, you may switch both using variables, as long as some or all fields are applicable. Alternatively, create a dummy Jira project with an issue type containing all required fields across your use cases, so you can handle varied field sets when creating issues\",\"position\":\"above\"}],\"objectActions\":[{\"actionType\":\"api\",\"rules\":[{\"type\":\"field\",\"refFieldName\":\"fields_sub_issuetype_sub_id\",\"refFieldValues\":[\"*\"],\"isCleared\":false,\"isVariable\":false},{\"type\":\"field\",\"refFieldName\":\"fields_sub_project_sub_key\",\"refFieldValues\":[\"*\"],\"isCleared\":false,\"isVariable\":false}],\"name\":\"GenerateSchema\",\"apiConfiguration\":{\"url\":\"/elements/uipath-atlassian-jira/objects/curated_create_issue/metadata?projectKey={fields_sub_project_sub_key}&issuetypeIds={fields_sub_issuetype_sub_id}&issuetypeId={fields_sub_issuetype_sub_id}&projectKeys={fields_sub_project_sub_key}&expand=projects.issuetypes.fields&includeParentArray=true\",\"method\":\"GET\"},\"onSuccess\":{\"type\":\"remap\",