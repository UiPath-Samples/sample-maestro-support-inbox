    {
      "id": "finalizeRefund",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Write reply and refund note",
        "icon": "code",
        "subLabel": "",
        "color": "#ED145B"
      },
      "inputs": {
        "script": "\n  const route = $vars.refundRoute || \"none\";\n  if (route === \"none\") {\n    return { replyText: $vars.classify.output.replyText, refundDecision: \"none\", refundReason: \"No refund was requested.\", ticketNote: \"\" };\n  }\n  const r = $vars.checkRefund.output;\n  const contact = String($vars.billingLookup.output.contactName || \"\").trim();\n  const firstName = contact ? contact.split(\" \")[0] : \"there\";\n  const accountId = $vars.billingLookup.output.found ? $vars.billingLookup.output.accountId : \"\";\n  const about = accountId ? \"your refund request for account \" + accountId : \"your refund request\";\n  const amount = \"$\" + (Number(r.amount) || 0).toFixed(2);\n  const charge = String(r.chargeDescription || \"the charge\").trim();\n  const invoice = String(r.invoice || \"\").trim();\n  const chargeText = charge + (invoice ? \" (invoice \" + invoice + \")\" : \"\");\n  const explanation = String(r.customerExplanation || \"\").trim();\n  const refundId = $vars.refundId || \"\";\n  let body = \"\";\n  if (route === \"auto_approve\") {\n    body = \"We checked \" + about + \" against your billing records and our refund policy, and we have approved a refund of \" + amount + \" for \" + chargeText + \". \" + explanation\n      + \"\\n\\nYour refund ID is \" + refundId + \". The refund goes back to the payment method that was charged.\";\n  } else if (route === \"human_approval\") {\n    body = \"We checked \" + about + \" against your billing records and our refund policy. Your request for a refund of \" + amount + \" for \" + chargeText + \" is now under review: refunds over $50 are approved by a member of our billing team before they are issued, so it has not been issued yet. \" + explanation\n      + \"\\n\\nWe will email you as soon as the review is complete.\";\n  } else {\n    body = \"We checked \" + about + \" against your billing records and our refund policy, and we are not able to issue a refund. \" + explanation;\n  }\n  const replyText = \"Hello \" + firstName + \",\\n\\nThank you for contacting us. \" + body + \"\\n\\nSupport team\";\n  let note = \"\\n\\n---\\nRefund decision: \" + route + \"\\nReason: \" + String(r.reason || \"\") + \"\\nAccount: \" + (accountId || \"(not found)\");\n  if (invoice) note = note + \"\\nCharge: \" + chargeText + ((Number(r.amount) || 0) > 0 ? \", refund amount \" + amount : \"\");\n  if (refundId) note = note + \"\\nRefund ID: \" + refundId;\n  if (route === \"human_approval\") note = note + \"\\nWaiting for approval in Action Center.\";\n  if (r.flaggedForReview === true) note = note + \"\\nFlagged for review: the email contains text that tries to change the refund decision.\";\n  return { replyText: replyText, refundDecision: route, refundReason: String(r.reason || \"\"), ticketNote: note };\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "replyText": {
              "type": "string"
            },
            "refundDecision": {
              "type": "string"
            },
            "refundReason": {
              "type": "string"
            },
            "ticketNote": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "d85c051b-da2a-4be8-871f-a02b4cbdb263"
    },
    {
      "id": "byCategory",
      "type": "core.logic.switch",
      "typeVersion": "1.4",
      "display": {
        "label": "byCategory",
        "icon": "between-horizontal-start"
      },
      "inputs": {
