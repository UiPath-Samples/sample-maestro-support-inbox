    {
      "id": "refundUpTo50",
      "type": "core.logic.decision",
      "typeVersion": "1.4",
      "display": {
        "label": "refundUpTo50",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "$50 or less",
        "falseLabel": "Over $50",
        "expression": "Number($vars.checkRefund.output.amount) <= 50"
      },
