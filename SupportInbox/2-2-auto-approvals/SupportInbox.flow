    {
      "id": "needsApproval",
      "type": "core.logic.decision",
      "typeVersion": "1.4",
      "display": {
        "label": "needsApproval",
        "icon": "trending-up-down",
        "subLabel": "",
        "color": "#FFB40E"
      },
      "inputs": {
        "trueLabel": "Over $50: approval",
        "falseLabel": "False",
        "expression": "$vars.refundRoute === \"human_approval\""
      },
      "uniqueId": "2a0f397b-5aec-408c-81ed-a31e68b65f02"
    },
    {
      "id": "autoApproveOn",
      "type": "core.logic.decision",
      "typeVersion": "1.4",
      "display": {
        "label": "autoApproveOn",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "autoApprove input is true",
        "falseLabel": "Ask a person",
        "expression": "$vars.start.output.autoApprove === true"
      },
      "uniqueId": "63dc5566-f7de-4d80-b761-cbe70fb52c30"
    },
    {
      "id": "approveRefund",
      "type": "uipath.human-in-the-loop",
      "typeVersion": "1.7",
      "display": {
        "label": "approveRefund",
        "icon": "users",
        "subLabel": "",
        "color": "#ED145B"
      },
      "inputs": {
        "type": "quick",
        "title": "Approve refund over $50",
        "priority": "Medium",
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "schema": {
          "schemaId": "cbb92f2b-b286-5872-9e3e-70d22e343fd4",
          "fields": [
            {
              "id": "ticket",
              "label": "Jira ticket",
              "type": "string",
              "direction": "input",
              "binding": "vars.ticketKey"
            },
            {
              "id": "accountId",
              "label": "Account",
              "type": "string",
              "direction": "input",
              "binding": "vars.billingLookup.output.accountId"
            },
            {
              "id": "invoice",
              "label": "Invoice",
              "type": "string",
              "direction": "input",
              "binding": "vars.checkRefund.output.invoice"
            },
            {
              "id": "charge",
              "label": "Charge",
              "type": "string",
              "direction": "input",
              "binding": "vars.checkRefund.output.chargeDescription"
            },
            {
              "id": "amount",
              "label": "Refund amount (USD)",
              "type": "number",
              "direction": "input",
              "binding": "vars.checkRefund.output.amount"
            },
            {
              "id": "reason",
              "label": "Why the policy allows it",
              "type": "string",
              "direction": "input",
              "binding": "vars.checkRefund.output.reason"
            },
            {
              "id": "comment",
              "label": "Comment",
              "type": "string",
              "direction": "output",
              "variable": "vars.comment"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "comment": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "455f76fa-ef90-4d28-90bb-fe1e979fc357"
    },
    {
      "id": "refundApproved",
      "type": "core.logic.decision",
      "typeVersion": "1.4",
      "display": {
        "label": "refundApproved",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "Approved",
        "falseLabel": "Rejected",
        "expression": "$vars.start.output.autoApprove === true || $vars.approveRefund?.output?.Action === \"Approve\""
      },
      "uniqueId": "4e5c01e5-d8a0-4873-bb66-10399940bc45"
    },
    {
      "id": "accountsPayableApproved",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Accounts Payable (mock)",
        "icon": "code",
        "subLabel": "",
        "color": "#ED145B"
      },
      "inputs": {
        "script": "\n  // Mock Accounts Payable: issues the refund and returns a refund ID made from the invoice number.\n  const invoice = String($vars.checkRefund.output.invoice || \"\").trim();\n  return { refundId: \"RF-\" + (invoice || \"UNKNOWN\"), invoice: invoice, amount: Number($vars.checkRefund.output.amount) || 0 };\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "refundId": {
              "type": "string"
            },
            "invoice": {
              "type": "string"
            },
            "amount": {
              "type": "number"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "530dc3cc-f01b-48ab-833c-f485976ac8eb"
    },
