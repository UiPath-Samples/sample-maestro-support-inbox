    {
      "id": "billingLookup",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Billing lookup (mock)",
        "icon": "code",
        "subLabel": "",
        "color": "#ED145B"
      },
      "inputs": {
        "script": "\n  // Mock billing system: a copy of company-data/accounts.json. A real deployment would call a database, an API or Data Fabric.\n  const accounts = [{\"id\":\"FW-10008\",\"company\":\"Halvorsen Freight\",\"contact\":\"Ingrid Halvorsen\",\"email\":\"ingrid@halvorsenfreight.example\",\"plan\":\"Business\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2024-03-11\",\"monthly_price\":249,\"payment_method\":\"card ending 7731\",\"charges\":[{\"date\":\"2026-10-03\",\"invoice\":\"INV-2026-10-0031\",\"description\":\"Business plan, monthly\",\"amount\":249,\"status\":\"paid\"},{\"date\":\"2026-11-03\",\"invoice\":\"INV-2026-11-0044\",\"description\":\"Business plan, monthly\",\"amount\":249,\"status\":\"paid\"},{\"date\":\"2026-11-03\",\"invoice\":\"INV-2026-11-0045\",\"description\":\"Business plan, monthly\",\"amount\":249,\"status\":\"paid\"}]},{\"id\":\"FW-10012\",\"company\":\"Quarry Lane Studio\",\"contact\":\"Dev Raman\",\"email\":\"dev@quarrylane.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-06-02\",\"monthly_price\":79,\"payment_method\":\"card ending 5520\",\"charges\":[{\"date\":\"2026-10-01\",\"invoice\":\"INV-2026-10-0102\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"},{\"date\":\"2026-10-20\",\"invoice\":\"INV-2026-10-0377\",\"description\":\"Upgrade to Team, prorated (Oct 20-31)\",\"amount\":23.23,\"status\":\"paid\"},{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0012\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"},{\"date\":\"2026-11-05\",\"invoice\":\"INV-2026-11-0098\",\"description\":\"Extra build minutes pack (1,000 min)\",\"amount\":12,\"status\":\"paid\"},{\"date\":\"2026-11-05\",\"invoice\":\"INV-2026-11-0099\",\"description\":\"Extra build minutes pack (1,000 min)\",\"amount\":12,\"status\":\"paid\"}]},{\"id\":\"FW-10015\",\"company\":\"Brightloaf Bakery\",\"contact\":\"Maya Okafor\",\"email\":\"maya@brightloaf.example\",\"plan\":\"Starter\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-09-14\",\"monthly_price\":19,\"payment_method\":\"card ending 0412\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0021\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"}]},{\"id\":\"FW-10017\",\"company\":\"Sunpath Solar\",\"contact\":\"Diego Alvarez\",\"email\":\"diego@sunpathsolar.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2024-11-30\",\"monthly_price\":79,\"payment_method\":\"card ending 8814\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0023\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"}]},{\"id\":\"FW-10019\",\"company\":\"Corvid Analytics\",\"contact\":\"Sam Whitfield\",\"email\":\"sam@corvidanalytics.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-01-08\",\"monthly_price\":79,\"payment_method\":\"card ending 2290\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0026\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"}]},{\"id\":\"FW-10021\",\"company\":\"Tessellate Games\",\"contact\":\"Lena Fischer\",\"email\":\"lena@tessellate.example\",\"plan\":\"Starter\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2026-02-17\",\"monthly_price\":19,\"payment_method\":\"card ending 6403\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0028\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"}]},{\"id\":\"FW-10023\",\"company\":\"Marigold Tutoring\",\"contact\":\"Priya Nair\",\"email\":\"priya@marigoldtutoring.example\",\"plan\":\"Starter\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-08-05\",\"monthly_price\":19,\"payment_method\":\"card ending 1187\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0031\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"},{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0032\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"}]},{\"id\":\"FW-10025\",\"company\":\"Ironbark Coffee\",\"contact\":\"Zoe Turner\",\"email\":\"zoe@ironbarkcoffee.example\",\"plan\":\"Starter\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2026-05-22\",\"monthly_price\":19,\"payment_method\":\"card ending 9045\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0034\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"}]},{\"id\":\"FW-10027\",\"company\":\"Lumen & Lathe\",\"contact\":\"Oscar Brandt\",\"email\":\"oscar@lumenlathe.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-04-19\",\"monthly_price\":79,\"payment_method\":\"card ending 3376\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0037\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"},{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0037\",\"description\":\"Bandwidth overage, 577.5 GB at $0.08/GB (October)\",\"amount\":46.2,\"status\":\"paid\"}]},{\"id\":\"FW-10030\",\"company\":\"Kestrel Robotics Club\",\"contact\":\"Aisha Bello\",\"email\":\"aisha@kestrelrobotics.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-10-02\",\"monthly_price\":79,\"payment_method\":\"card ending 4761\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0041\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"}]},{\"id\":\"FW-10031\",\"company\":\"Oakmere Legal\",\"contact\":\"Hannah Cole\",\"email\":\"hannah@oakmerelegal.example\",\"plan\":\"Business\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2024-07-15\",\"monthly_price\":249,\"payment_method\":\"card ending 5058\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0042\",\"description\":\"Business plan, monthly\",\"amount\":249,\"status\":\"paid