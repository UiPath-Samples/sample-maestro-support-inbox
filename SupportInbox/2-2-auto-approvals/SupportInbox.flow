:\"FW-10044\",\"company\":\"Hollow Oak Games\",\"contact\":\"Ruth Adeyemi\",\"email\":\"ruth@hollowoak.example\",\"plan\":\"Starter\",\"cycle\":\"monthly\",\"status\":\"past_due\",\"created\":\"2025-12-01\",\"monthly_price\":19,\"payment_method\":\"card ending 0119\",\"charges\":[{\"date\":\"2026-10-01\",\"invoice\":\"INV-2026-10-0071\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"},{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0190\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"failed\"}]},{\"id\":\"FW-10045\",\"company\":\"Pixelmoss\",\"contact\":\"Felix Moreau\",\"email\":\"felix@pixelmoss.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-03-03\",\"monthly_price\":79,\"payment_method\":\"card ending 8862\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0063\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"},{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0063\",\"description\":\"Bandwidth overage, 1,500 GB at $0.08/GB (October)\",\"amount\":120,\"status\":\"paid\"}]},{\"id\":\"FW-10048\",\"company\":\"Larkhill Events\",\"contact\":\"Ama Mensah\",\"email\":\"ama@larkhillevents.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-12-09\",\"monthly_price\":79,\"payment_method\":\"card ending 4407\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0068\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"}]},{\"id\":\"FW-10049\",\"company\":\"Driftwood Data\",\"contact\":\"Nadia Haddad\",\"email\":\"nadia@driftwooddata.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-07-21\",\"monthly_price\":79,\"payment_method\":\"card ending 9931\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0069\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"},{\"date\":\"2026-11-10\",\"invoice\":\"INV-2026-11-0233\",\"description\":\"Build minutes overage, 1,900 min at $0.02/min (Nov 9-10)\",\"amount\":38,\"status\":\"paid\"}]},{\"id\":\"FW-10052\",\"company\":\"Glasshouse Co\",\"contact\":\"Rex Calloway\",\"email\":\"rex@glasshouse.example\",\"plan\":\"Starter\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2026-09-30\",\"monthly_price\":19,\"payment_method\":\"card ending 1450\",\"charges\":[{\"date\":\"2026-10-01\",\"invoice\":\"INV-2026-10-0080\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"},{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0072\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"}]},{\"id\":\"FW-10055\",\"company\":\"Amberline Logistics\",\"contact\":\"Chen Wei\",\"email\":\"chen@amberline.example\",\"plan\":\"Business\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2024-05-06\",\"monthly_price\":249,\"payment_method\":\"card ending 6672\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0075\",\"description\":\"Business plan, monthly\",\"amount\":249,\"status\":\"paid\"}]},{\"id\":\"FW-10057\",\"company\":\"Bluefin Tutors\",\"contact\":\"Olivia Grant\",\"email\":\"olivia@bluefintutors.example\",\"plan\":\"Starter\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-10-18\",\"monthly_price\":19,\"payment_method\":\"card ending 3015\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0078\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"}]},{\"id\":\"FW-10059\",\"company\":\"Wrenfield Outdoor\",\"contact\":\"Kai Nakamura\",\"email\":\"kai@wrenfield.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-05-25\",\"monthly_price\":79,\"payment_method\":\"card ending 5284\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0081\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"}]},{\"id\":\"FW-10061\",\"company\":\"Cobalt Kitchen\",\"contact\":\"Ravi Shah\",\"email\":\"ravi@cobaltkitchen.example\",\"plan\":\"Starter\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2026-03-08\",\"monthly_price\":19,\"payment_method\":\"card ending 7746\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0083\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"}]},{\"id\":\"FW-10063\",\"company\":\"Moonrise Yoga\",\"contact\":\"Elena Petrova\",\"email\":\"elena@moonriseyoga.example\",\"plan\":\"Starter\",\"cycle\":\"annual\",\"status\":\"active\",\"created\":\"2025-08-29\",\"monthly_price\":190,\"payment_method\":\"card ending 2208\",\"charges\":[{\"date\":\"2026-08-29\",\"invoice\":\"INV-2026-08-0412\",\"description\":\"Starter plan, annual (Aug 29, 2026 - Aug 28, 2027)\",\"amount\":190,\"status\":\"paid\"}]},{\"id\":\"FW-10066\",\"company\":\"Tallgrass Software\",\"contact\":\"Ben Okoro\",\"email\":\"ben@tallgrass.example\",\"plan\":\"Team\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2025-09-01\",\"monthly_price\":79,\"payment_method\":\"card ending 8390\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0086\",\"description\":\"Team plan, monthly\",\"amount\":79,\"status\":\"paid\"}]},{\"id\":\"FW-10070\",\"company\":\"Ridgeway Insurance Group\",\"contact\":\"Laura Kim\",\"email\":\"laura@ridgewayins.example\",\"plan\":\"Business\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2024-10-10\",\"monthly_price\":249,\"payment_method\":\"card ending 4129\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0090\",\"description\":\"Business plan, monthly\",\"amount\":249,\"status\":\"paid\"}]},{\"id\":\"FW-10074\",\"company\":\"Luma Ceramics\",\"contact\":\"Sofia Marin\",\"email\":\"sofia@lumaceramics.example\",\"plan\":\"Starter\",\"cycle\":\"monthly\",\"status\":\"active\",\"created\":\"2026-06-14\",\"monthly_price\":19,\"payment_method\":\"card ending 6051\",\"charges\":[{\"date\":\"2026-11-01\",\"invoice\":\"INV-2026-11-0093\",\"description\":\"Starter plan, monthly\",\"amount\":19,\"status\":\"paid\"}]}];\n  const wanted = String($vars.classify.output.accountId || \"\").trim().toUpperCase();\n  let account = null;\n  for (const a of accounts) {\n    if (a.id === wanted) account = a;\n  }\n  const requestDate = '2026-12-01'; // pinned: the demo data is from November 2026\n  return {\n    found: account !== null,\n    accountId: wanted,\n    accountJson: account ? JSON.stringify(account, null, 2) : \"No account was found for account ID \\\"\" + wanted + \"\\\".\",\n    contactName: account ? account.contact : \"\",\n    requestDate: requestDate,\n  };\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
